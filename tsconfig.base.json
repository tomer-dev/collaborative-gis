{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Node loads @cgis/shared and apps/api/src/db as TypeScript (Vite config files and the db
    // scripts import them natively), and Node resolves relative imports only with their real
    // extension: those imports name the .ts file.
    "allowImportingTsExtensions": true
  }
}
