# Dev-only image: runs the Worker on workerd with `wrangler dev` (D9: no Node server).
# Build context is the repo root (pnpm workspace); see docker-compose.yml `api`.
# Tag matches .node-version. Debian slim, not alpine: workerd needs glibc.
FROM node:24.21.0-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    WRANGLER_SEND_METRICS=false
RUN corepack enable
USER node
WORKDIR /app
# Manifests first so the install layer is cached until a dependency changes.
# Every workspace package.json must be present for --frozen-lockfile; only the api subtree is installed.
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node apps/api/package.json apps/api/
COPY --chown=node:node apps/web/package.json apps/web/
COPY --chown=node:node packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @cgis/api...
COPY --chown=node:node packages/shared packages/shared
COPY --chown=node:node apps/api apps/api
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8787/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
# Migrate (direct URL, DATABASE_URL) then serve; both point at the compose postgis service.
CMD ["sh", "-c", "pnpm --filter @cgis/api db:migrate && pnpm --filter @cgis/api exec wrangler dev --ip 0.0.0.0 --port 8787"]
