{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collaborative-gis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Retention purge (src/scheduled.ts), daily: RETENTION.CRON in @cgis/shared; a test fails if they differ.
  "triggers": { "crons": ["0 3 * * *"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ffdceaec4c3b4c70a324ebf9da6cb7a9",
      "localConnectionString": "postgresql://cgis:cgis@localhost:5433/cgis",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
  ],
  "vars": {
    "CLIENT_ORIGIN": "http://localhost:5173",
  },
  // Values live in .dev.vars locally and in `wrangler secret put` deployed; see .dev.vars.example.
  "secrets": { "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL"] },
}
