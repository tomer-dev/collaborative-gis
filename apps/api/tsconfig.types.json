{
  // Declarations only, for the SPA: apps/web references this project, so its `import type
  // { AppType }` reads dist-types/*.d.ts instead of type-checking the Worker's source under the
  // DOM lib. `tsc -b` in apps/web builds it first.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.types.tsbuildinfo",
    "types": []
  },
  "include": ["src", "worker-configuration.d.ts"]
}
