# Local (docker-compose), informational only: nothing reads it (the Worker uses wrangler.jsonc).
# scripts/db-check.sh deliberately uses the in-container port 5432: psql runs inside the container.
LOCAL_DATABASE_URL=postgresql://cgis:cgis@localhost:5433/cgis
# Neon direct (migrations only; never used by the Worker at runtime)
NEON_DATABASE_URL=
# Neon API key: injected from 1Password per command, do not store here
# NEON_API_KEY="op://Dev/tomercouch-neon/credential" op run -- neonctl <args>
